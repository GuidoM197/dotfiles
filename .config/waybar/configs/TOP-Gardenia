{
 
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"output": "DP-3",
"layer": "top",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 5,
"fixed-center": false,
"ipc": true,
"margin-top": 5,
//"margin-bottom": 5,
"width": 1000,
	
"modules-left": [
	"mpris",
	"tray",
	"group/notify"
	],

"modules-center": ["hyprland/workspaces#numbers"],

"modules-right": [
	"pulseaudio#1",
	"backlight#2",
	"battery",
	"clock#5",
	"custom/nightlight"
	],

}